@model PostToViewModel

<div class="post-card">
    <div class="post-header">
        <div class="post-header-author">
            <span class="post-author">@Model.Username</span>
            @if(!string.IsNullOrEmpty(Model.UserTitle))
            {
                <span class="post-author-title">@Model.UserTitle</span>
            }
        </div>
        <div class="post-header-date">
            <span class="post-date">@Model.PostDate.ToString("MMM dd, yyyy")</span>
        </div>
    </div>
    <div class="post-body">
        <h2 class="post-title">@Model.PostTitle</h2>
        <p class="post-content-body">@Model.PostBody</p>
    </div>
    <div class="post-actions">
        <div class="skills-section">
            @if(Model.UserSkills != null && Model.UserSkills.Any())
            {
                foreach(var skill in Model.UserSkills)
                {
                    <span class="skill-tag">@skill</span>
                }
            }
        </div>
        <div class="like-button @(Model.UserHasLiked ? "liked" : "")" data-post-id="@Model.PostId">
            <span class="emoji-button"></span><span class="like-count">@Model.LikeCount</span>
        </div>
        
    </div>
</div>