<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mentii</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/mentii-favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MentiiWebsite.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header-main">
        <div>
            <a asp-controller="Home" asp-action="Index" asp-area="Default">
                <img class="header-logo"
                     src="~/images/mentii-logo300x80.png"
                     alt="Mentii Logo" />
            </a>
        </div>
        <div>
            <nav class="header-nav">
                <div class="nav-links">
                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <span class="user-greeting">Hello, @User.Identity.Name!</span>
                        <form id="profileForm" method="get" asp-area="Default" asp-controller="User" asp-action="Profile">
                            <input id="usernameField" type="hidden" name="username" value="@User.Identity.Name" />
                            <button class="icon-button" type="submit" title="@User.Identity.Name's Profile">
                                <i class="icon-regular fa-regular fa-lg fa-user"></i>
                                <i class="icon-solid fa-solid fa-lg fa-user"></i>
                            </button>
                        </form>
                        <form method="post" asp-area="Default" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button class="btn btn_mentii" type="submit">Logout</button>
                        </form>
                        @if (User.IsInRole("Admin"))
                        {
                            <form>
                                <button class="icon-button" type="submit" asp-area="Admin" asp-controller="User" asp-action="Index" title="Admin Panel">
                                    <i class="icon-regular fa-regular fa-xl fa-id-badge"></i>
                                    <i class="icon-solid fa-solid fa-xl fa-id-badge"></i>
                                </button>
                            </form>
                                
                        }
                    }
                    else
                    {
                        <a class="btn btn_mentii" asp-area="Default" asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
            </nav>
        </div>
    </header>
    <div class="body-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Mentii - <a asp-area="Default" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://kit.fontawesome.com/c42a8c8e8b.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
