@model User

@{
    ViewData["Title"] = "Login";
}

<h3>User Login</h3>

<div>
    <form method="post" asp-controller="Account" asp-action="Login">
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="UserUsername"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="UserUsername" class="form-control" />
                <span asp-validation-for="UserUsername" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="UserPassword"></label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="UserPassword" class="form-control" />
                <span asp-validation-for="UserPassword" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <input type="submit" value="Login" class="btn btn-primary" />
            </div>
            <div class="col-5"></div>
        </div>
    </form>
    <div>
        <p>Don't have an account? <a asp-controller="Account" asp-action="Signup">Sign up here</a>.</p>
    </div>
</div>