@model SignupViewModel

@{
    ViewData["Title"] = "Signup";
}

<h3>User Signup</h3>

<div>
    <form method="post" asp-controller="Account" asp-action="Signup">
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="FirstName"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="LastName"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="Username"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="Email"></label>
            </div>
            <div class="col-5">
                <input type="email" asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="Password"></label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="Birthday"></label>
            </div>
            <div class="col-5">
                <input type="date" asp-for="Birthday" class="form-control" />
                <span asp-validation-for="Birthday" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="Title"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <label asp-for="SkillsRaw"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="SkillsRaw" placeholder="Type a skill and separate with commas" autocomplete="off" />
                <span asp-validation-for="SkillsRaw" class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-2">
                <input type="submit" value="Sign Up" class="btn btn_mentii" />
            </div>
            <div class="col-5"></div>
        </div>
    </form>
    <div>
        <p>Already have an account? <a asp-controller="Account" asp-action="Login" class="mentii-link">Login here</a>.</p>
    </div>
</div>