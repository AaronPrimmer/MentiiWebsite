@model UserProfileViewModel

@if(Model == null)
{
    ViewData["Title"] = "User not found";
}
else
{
    ViewData["Title"] = Model.UserName + "'s Profile";
}

@if (Model == null)
{
    <h2>User not found</h2>
    <p>The user you are looking for does not exist.</p>
}
else
{
    <h3>@Model.UserName 's Profile</h3>

    <div class="profile-container">
        <form method="post" asp-controller="User" asp-action="Profile">
            @Html.AntiForgeryToken()
            <div class="profile-form">
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserName"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserName" type="email" class="form-control" disabled />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserEmail"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserEmail" type="email" class="form-control" disabled />
                        <span asp-validation-for="UserEmail" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserFirstName"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserFirstName" type="text" class="form-control" />
                        <span asp-validation-for="UserFirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserLastName"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserLastName" type="text" class="form-control" />
                        <span asp-validation-for="UserLastName" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserTitle"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserTitle" type="text" class="form-control" />
                        <span asp-validation-for="UserTitle" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserSkills"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserSkills" type="text" class="form-control" value="@string.Join(", ", Model.UserSkills)" />
                        <span asp-validation-for="UserSkills" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-2">
                        <label asp-for="UserBirthday"></label>
                    </div>
                    <div class="col-5">
                        <input asp-for="UserBirthday" type="date" class="form-control" disabled value="@Model.UserBirthday.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="UserBirthday" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="profile-form-save-button">
                <button type="submit" class="btn_mentii">Save Changes</button>
            </div>
        </form>
    </div>
}