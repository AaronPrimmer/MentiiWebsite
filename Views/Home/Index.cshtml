@{
    ViewData["Title"] = "Welcome";
}

<h2>Welcome</h2>

@if(User.Identity.IsAuthenticated)
{
    <p>Welcome back, @User.Identity.Name!</p>
    <p><a asp-controller="Home" asp-action="Dashboard">Go to your dashboard</a></p>
}
else
{
    <p>Welcome to Mentii! Please <a asp-controller="Account" asp-action="Login">log in</a> or <a asp-controller="Account" asp-action="Signup">sign up</a> to get started.</p>
}
)
