@model UserViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<h3 class="mb-3">Admin Panel</h3>

<h5><a class="mt-2" asp-controller="Account" asp-area="default" asp-action="Register">Add a User</a></h5>

<table class="table table-striped table-bordered table-sm">
    <thead>
        <tr>
            <th>Username</th>
            <th>Roles</th>
            <th>Delete User</th>
            <th>Manage Roles</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Users == null || !Model.Users.Any())
        {
            <tr>
                <td colspan="4">No users found.</td>
            </tr>
        }
        else
        {
            @foreach (ApplicationUser user in Model.Users)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        @if(user.RoleNames == null || !user.RoleNames.Any())
                        {
                            <div>No roles assigned</div>
                        }
                        else
                        {
                            @foreach (string roleName in user.RoleNames)
                            {
                                <div>@roleName</div>
                            }
                        }
                        
                    </td>
                    <td>
                        <form method="post" asp-controller="User" asp-action="Delete" asp-route-id="@user.Id">
                            <button class="btn btn-danger" type="submit" >Delete</button>
                        </form>
                        
                    </td>
                    <td>
                        @if(Model.Roles != null)
                        {   
                            @foreach(var role in Model.Roles)
                            {
                                if(user.RoleNames != null && role.Name != null && !user.RoleNames.Contains(role.Name))
                                {
                                    <form method="post" asp-area="Admin" asp-controller="User" asp-action="AddToRole" asp-route-userId="@user.Id" asp-route-roleName="@role.Name">
                                        <button class="btn btn_mentii" type="submit">Add @role.Name</button>
                                    </form>
                                        
                                }
                                else
                                {
                                    @if(user.UserName != "admin")
                                    {
                                        <form method="post" asp-area="Admin" asp-controller="User" asp-action="RemoveFromRole" asp-route-userId="@user.Id" asp-route-roleName="@role?.Name">
                                            <button class="btn btn-danger" type="submit">Remove @role?.Name</button>
                                        </form>
                                            
                                    }
                                
                                }
                            }
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<h3>Manage Roles</h3>

<form method="post" asp-action="CreateRole">
    <div class="row mb-3">
        <div class="col-2"></div>
        <label for="roleName">Role Name</label>
        <div class="col-5">
            <input type="text" class="form-control" id="roleName" name="roleName" placeholder="Role Name">
            <button type="submit" class="btn btn_mentii">Create Role</button>
        </div>
    </div>
</form>

@if(Model.Roles != null)
{
    @if (!Model.Roles.Any(role => role.Name?.ToLower() == "admin"))
    {
        <form method="post" asp-action="CreateAdminRole">
            <button type="submit" class="btn btn_mentii">Create Admin Role</button>
        </form>
    }
    else
    {
        <table class="table table-bordered table-striped table-sm">
            <thead>
                <tr>
                    <th>Role Name</th>
                    <td></td>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>
                            @if(role.Name?.ToLower() != "admin")
                            {
                                <form method="post" asp-action="DeleteRole" asp-route-roleId="@role.Id">
                                    <button class="btn btn-danger" type="submit">Delete Role</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
